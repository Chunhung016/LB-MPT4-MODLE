rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // App Settings (Maintenance mode & Broadcast alerts)
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Parent and Student Profiles
    match /parent_profiles/{username} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Registered Hardware & Devices
    match /devices/{deviceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Reception QR Activation Queue
    match /activation_requests/{requestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Staff Directory
    match /staff_users/{email} {
      allow read: if true;
      allow write: if true;
    }

    // Spelling Bee Leaderboard
    match /spelling_bee_leaderboard/{id} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}
