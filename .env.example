# Firebase web configuration is public and has safe checked-in defaults.
# Override these only when connecting a different Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_USE_FIREBASE_EMULATORS=false
GEMINI_API_KEY=

# Optional local server credentials. Production uses Vercel OIDC.
FIREBASE_SERVICE_ACCOUNT_JSON=
